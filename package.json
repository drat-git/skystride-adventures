{
  "name": "skystride-adventures",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:mac": "npm run typecheck && node scripts/package-mac.mjs",
    "build:windows": "node scripts/package-windows.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/test-overhaul-browser.mjs",
    "test:hosted": "node --env-file=.env.local scripts/test-overhaul-hosted.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "test:editor": "node scripts/test-overhaul-editor.mjs",
    "test:runtime": "node scripts/test-overhaul-runtime.mjs",
    "test:courses:ground": "node scripts/test-overhaul-official-ground.mjs",
    "test:courses:sky": "node scripts/test-overhaul-sky.mjs",
    "test:courses:final": "node scripts/test-overhaul-official-sky6.mjs",
    "test:production": "node scripts/test-overhaul-production.mjs",
    "test:title": "node scripts/test-title-navigation.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electron/packager": "20.3.0",
    "@types/node": "^22.20.5",
    "electron": "45.2.3",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
